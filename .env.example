# =============================================================================
# API keys
#
# Copy to `.env.local`. Everything here is optional — the dashboard runs without any
# keys at all, using the keyless sources (Treasury, ECB, LBMA, PortWatch, BIS,
# GDELT, CoinGecko). Keys unlock coverage, and `npm run sources` shows which
# connectors are currently disabled for want of one.
#
# FRED is by far the highest-value key: one free signup unlocks roughly half of
# all indicators, including the entire credit pillar.
# =============================================================================

# FRED — Federal Reserve Economic Data.  https://fredaccount.stlouisfed.org/apikeys
# Free, instant, no card. Unlocks: credit spreads, repo rates, swap lines, M2,
# bank credit, Sahm rule, claims, housing, VIX. Without it the credit, real
# economy and markets pillars have no data at all.
FRED_API_KEY=

# EIA — US Energy Information Administration.  https://www.eia.gov/opendata/register.php
# Free, instant. Unlocks: crude and distillate inventories, refinery utilisation,
# SPR level, and daily electricity demand.
EIA_API_KEY=

# CoinGecko — optional. https://www.coingecko.com/en/api/pricing
# The connector works without a key; a free demo key raises the rate limit and
# extends history beyond ~365 days.
COINGECKO_API_KEY=

# -----------------------------------------------------------------------------
# Overrides (rarely needed)
# -----------------------------------------------------------------------------
# WD_DB_PATH=/absolute/path/to/world.db
# WD_CONFIG_PATH=/absolute/path/to/indicators.yaml
# PORT=8787
